<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lakeland.audit.weekly</string>
  <key>Disabled</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/david_huff/lakeland-health-insurance/scripts/audit/run-scheduled-macos.mjs</string>
    <string>--broker</string>
    <string>/Users/david_huff/.config/lhi-audit/google-token-broker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>WorkingDirectory</key><string>/Users/david_huff/lakeland-health-insurance</string>
  <key>StandardOutPath</key><string>/Users/david_huff/lakeland-health-insurance/.audit-data/logs/weekly.out.log</string>
  <key>StandardErrorPath</key><string>/Users/david_huff/lakeland-health-insurance/.audit-data/logs/weekly.err.log</string>
</dict>
</plist>
