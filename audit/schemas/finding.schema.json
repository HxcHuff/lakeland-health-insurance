{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakelandhealthinsurance.com/audit/schemas/finding.schema.json",
  "title": "Audit finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ruleId", "category", "severity", "score", "url", "summary", "evidence", "recommendedAction", "automaticActionAllowed", "verificationRequired"],
  "properties": {
    "id": {"type": "string"},
    "ruleId": {"type": "string"},
    "category": {"enum": ["confidentiality", "compliance", "technical", "metadata", "indexing", "search-performance", "analytics", "content-control"]},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "url": {"type": ["string", "null"]},
    "summary": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "recommendedAction": {"type": "string"},
    "automaticActionAllowed": {"const": false},
    "verificationRequired": {"type": "boolean"},
    "dimensions": {
      "type": "object",
      "required": ["risk", "visibility", "confidence", "recency"],
      "properties": {
        "risk": {"type": "number", "minimum": 1, "maximum": 5},
        "visibility": {"type": "number", "minimum": 1, "maximum": 5},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recency": {"type": "number", "minimum": 0.5, "maximum": 1.5}
      }
    }
  }
}
