  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Append UTM params to Calendly URL if present
      const utm = window.UTM_DATA || {};
      const iframe = document.querySelector('iframe');
      const fallbackLink = document.querySelector('.calendly-fallback a');
      
      if (Object.keys(utm).length && iframe) {
        const currentSrc = iframe.getAttribute('src');
        const url = new URL(currentSrc);
        Object.entries(utm).forEach(([key, val]) => {
          url.searchParams.set(key, val);
        });
        iframe.setAttribute('src', url.toString());
        
        // Update fallback link too
        if (fallbackLink) {
          const fallbackUrl = new URL(fallbackLink.getAttribute('href'));
          Object.entries(utm).forEach(([key, val]) => {
            fallbackUrl.searchParams.set(key, val);
          });
          fallbackLink.setAttribute('href', fallbackUrl.toString());
        }
      }

      // Track page load
      if (typeof gtag === 'function') {
        gtag('event', 'calendly_page_view', {
          event_category: 'engagement',
          event_label: 'calendly_direct_page'
        });
      }
    });

    // Calendly event tracking
    window.addEventListener('message', function(e) {
      if (e.origin === "https://calendly.com" && e.data.event === "calendly.event_scheduled") {
        // Google Analytics 4 event
        if (typeof gtag === 'function') {
          gtag('event', 'calendly_booking', {
            event_category: 'conversion',
            event_label: 'direct_calendly_booking',
            value: 1
          });
        }
        
        // Facebook Pixel event
        if (typeof fbq === 'function') {
          fbq('track', 'Lead', {
            content_name: 'Direct Calendly Appointment',
            value: 1.00,
            currency: 'USD'
          });
        }
        
        // Optional: Show confirmation
        setTimeout(() => {
          console.log('🎉 Appointment booked successfully!');
        }, 1000);
      }
    });
  </script>
