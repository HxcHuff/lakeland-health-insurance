  <!-- UTM CAPTURE / SESSION STORAGE -->
  <script>
    (function () {
      const KEYS = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content',
        'fbclid',
        'gclid'
      ];

      function collectParams() {
        const params = new URLSearchParams(window.location.search);
        const data = {};
        KEYS.forEach((k) => {
          const val = params.get(k) || sessionStorage.getItem(k);
          if (val) {
            data[k] = val;
            sessionStorage.setItem(k, val);
          }
        });
        return data;
      }

      window.UTM_DATA = collectParams();
    })();
  </script>

