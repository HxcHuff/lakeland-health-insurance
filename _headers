/*
  Content-Security-Policy: default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.doubleclick.net https://www.googleadservices.com https://www.googletagmanager.com https://www.gstatic.com https://bzrcdn.openai.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https: data:; img-src 'self' data: https: blob: https://*.doubleclick.net https://www.googleadservices.com; connect-src 'self' https: wss: data: blob: https://*.doubleclick.net https://www.googleadservices.com https://bzr.openai.com; frame-src 'self' https: data:; font-src 'self' data: https: blob:; media-src 'self' https: data: blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; child-src 'self' https: data: blob:; worker-src 'self' blob: https: data:; manifest-src 'self' https:;
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), attribution-reporting=*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Long cache for stable, content-addressed-by-name assets.
# Fonts are versioned by filename; safe to cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons are stable PWA assets — name changes if content changes.
/icons/*
  Cache-Control: public, max-age=2592000

# Service worker script must always revalidate so releases propagate immediately
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed CSS/JS — 1 hour with 24h stale-while-revalidate so returning
# visitors get instant loads while a deploy propagates quickly.
# Bump query string (?v=) on a critical change to force-bust.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Static images, videos, and downloads under /assets/
/assets/*
  Cache-Control: public, max-age=2592000

# Top-level static images (hero photos, OG card)
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000
